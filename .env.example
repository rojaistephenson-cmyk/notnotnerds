# Password required to open /admin. Change this before you show the site to anyone.
ADMIN_PASSWORD=changeme

# Random string used to sign the admin session cookie. Any long random value works, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Database ---------------------------------------------------------------
# Leave both blank for local dev: the app falls back to a local SQLite file
# at data/notnotnerds.db, created automatically.
#
# For production (Vercel), create a free database at https://turso.tech and
# paste its values here (and in Vercel's Environment Variables):
#   turso db create notnotnerds
#   turso db show notnotnerds --url          -> DATABASE_URL (starts with libsql://)
#   turso db tokens create notnotnerds        -> DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=
